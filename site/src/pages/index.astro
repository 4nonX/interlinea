<script is:inline>
(() => {
  const lang = (navigator.languages || [navigator.language]).map((l) => String(l).slice(0, 2)).find((l) => l === 'de' || l === 'ko' || l === 'fr');
  if (!lang || lang === 'de') return;
  document.querySelectorAll('.gl-gloss').forEach((g) => { g.textContent = g.dataset[lang]; g.lang = lang; });
})();
</script>
<script is:inline>
(() => {
  // the gloss turns through German, Korean and French while the pointer rests on the headline
  const h1 = document.getElementById('hero-h');
  const gloss = [...document.querySelectorAll('.gl-gloss')];
  if (!h1 || !gloss.length || !matchMedia('(hover: hover) and (pointer: fine)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const order = ['de', 'ko', 'fr'];
  const home = gloss[0].lang;
  let timer = 0, at = order.indexOf(home);
  const show = (lang) => {
    gloss.forEach((g) => g.classList.add('is-swapping'));
    setTimeout(() => gloss.forEach((g) => { g.textContent = g.dataset[lang]; g.lang = lang; g.classList.remove('is-swapping'); }), 220);
  };
  h1.addEventListener('pointerenter', () => {
    clearInterval(timer);
    timer = setInterval(() => { at = (at + 1) % order.length; show(order[at]); }, 1600);
  });
  h1.addEventListener('pointerleave', () => {
    clearInterval(timer);
    if (gloss[0].lang !== home) { at = order.indexOf(home); show(home); }
  });
})();
</script>
