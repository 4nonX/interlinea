---
// The landing page. Built on the kit in public/assets (tasteskill, MIT): its
// system.css, motion, moments and diagrams load as plain files from /assets.
// The release it links to is read from GitHub when the site is built.
import '@fontsource-variable/instrument-sans/wdth.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import { latestRelease, asset, size, longDate, github } from '../lib/release.mjs';

const release = await latestRelease();
const v = release.version;
const win = asset(release, /windows-x64-setup\.exe$/);
const winZip = asset(release, /windows-x64-portable\.zip$/);
const mac = asset(release, /macos-universal\.dmg$/);
const linux = asset(release, /linux-x86_64\.AppImage$/);
const releasePage = `${github}/releases/tag/v${v}`;
const withSize = (a, text) => (a && a.size ? `${text}, ${size(a.size)}` : text);
const title = 'Interlinea: open-source CAT tool for translators';
const description = 'Translate documents, subtitles and Trados or memoQ packages with memories, termbases and checks. Free for Windows, macOS, Linux and the browser.';
---
<!doctype html>
<html lang="en" data-type="software" data-radius="soft" data-ground="sky" data-buttons="pill" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content="Memories, termbases, checks and project workflow. Opens Trados and memoQ packages and sends them back. Free and open source.">
<meta property="og:image" content="https://interlinea.dev/share.jpg">
<meta property="og:url" content="https://interlinea.dev/">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="canonical" href="https://interlinea.dev/">
<meta name="theme-color" content="#f3f5f8">
<meta name="site-kind" content="software">
<meta name="page-type" content="software">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<style is:inline>
:root {
  --p-bg: #f3f5f8; --p-surface: #ffffff; --p-ink: #1a1f26; --p-muted: #4c5562;
  --p-accent: #1f5bd6; --p-accent-ink: #f3f5f8; --p-action: #1f5bd6; --p-action-ink: #f3f5f8;
  --p-inv-bg: #1a1f26; --p-inv-surface: #262b32; --p-inv-ink: #f3f5f8; --p-inv-muted: #989ca1;
  --p-inv-accent: #f3f5f8; --p-inv-accent-ink: #1a1f26; --p-inv-action: #f3f5f8; --p-inv-action-ink: #1a1f26;
  --font-display: "Instrument Sans Variable", "Instrument Sans", system-ui, sans-serif;
  --font-text: "Instrument Sans Variable", "Instrument Sans", system-ui, sans-serif;
  --font-mono: "DM Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --display-weight: 500;
  --display-tracking: -0.028em;
  --display-tracking-xl: -0.036em;
  --display-stretch: 96%;
  --ly-scale: 1.04;
}
</style>
<link rel="stylesheet" href="/assets/diagrams/diagram.css">
<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script is:inline src="/assets/backgrounds/backgrounds.js"></script>
<script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
<link rel="modulepreload" href="/assets/moments/moments.js">
<link rel="modulepreload" href="/assets/moments/lib.js">
<link rel="modulepreload" href="/assets/moments/pinned-chapters/moment.js">
<link rel="modulepreload" href="/assets/moments/liquid-type/moment.js">
<style is:inline>
/* The mark: the app's own icon, three lines with the middle one lighter. */
.il-mark { width: 1.15em; height: 1.15em; flex: none; display: inline-block; vertical-align: -0.2em; }
.nav__logo, .footer__mark { display: inline-flex; align-items: center; gap: 10px; }

/* The headline is set with an interlinear gloss: under each line, the same words in another
   language, small, in a serif italic: German, or Korean or French for a browser set to those. */
.hero--centred h1 { max-width: none; }
.gl-line { display: block; }
.gl-gloss { display: block; font: italic 400 clamp(17px, 0.3em, 24px)/1.15 "Instrument Serif", Georgia, serif;
  letter-spacing: 0; font-stretch: 100%; color: var(--accent); margin: 0.02em 0 0.1em; }
.gl-line:last-child .gl-gloss { margin-bottom: 0; }
.gl-gloss[lang="ko"] { font-style: normal; font-family: "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", sans-serif; font-size: clamp(15px, 0.26em, 20px); }
.hero--centred .hero__lead { color: var(--ink); }

/* The hero's window: the editor with one segment being translated. */
.hero--centred .hero__window { background:
  radial-gradient(70% 90% at 50% 0%, rgb(255 255 255 / .75), transparent 70%),
  radial-gradient(60% 80% at 12% 100%, #9dbcf3 0, transparent 70%),
  radial-gradient(55% 75% at 92% 90%, #b9cdf5 0, transparent 70%),
  linear-gradient(180deg, #dfe8f8, #c4d6f6); }
.ed { background: #fff; color: #1a1f26; border-radius: 12px; overflow: hidden; font: 400 14px/1.45 var(--font-text); text-align: left;
  box-shadow: 0 0 0 1px rgb(26 31 38 / .08), 0 30px 60px -28px rgb(20 50 120 / .45); }
.ed__bar { display: flex; align-items: center; gap: 10px; height: 44px; padding: 0 16px; border-bottom: 1px solid #e6eaf0; font-size: 13px; color: #4c5562; }
.ed__bar b { color: #1a1f26; font-weight: 500; }
.ed__dots { display: flex; gap: 6px; } .ed__dots i { width: 10px; height: 10px; border-radius: 50%; background: #dfe3e9; }
.ed__tag { font: 500 11px/1 var(--font-mono); padding: 3px 5px; border-radius: 4px; background: #eef1f5; color: #4c5562; }
.ed__sp { flex: 1; }
.ed__prog { display: grid; gap: 4px; font-size: 12px; color: #4c5562; }
.ed__prog i { display: block; height: 4px; width: 132px; border-radius: 99px; background: #e6eaf0; overflow: hidden; }
.ed__prog i::before { content: ""; display: block; height: 100%; width: 25%; background: #17703f; border-radius: inherit; }
.ed__body { display: grid; grid-template-columns: minmax(0, 1fr) 248px; }
.ed__segs { border-right: 1px solid #e6eaf0; }
.ed__row { display: grid; grid-template-columns: 30px minmax(0, 1fr) minmax(0, 1fr) 28px; gap: 0 14px; padding: 10px 14px 10px 10px; border-bottom: 1px solid #eef1f5; align-items: start; }
.ed__row .n { color: #7b8491; font-size: 12px; text-align: right; padding-top: 2px; }
.ed__row .tgt { min-height: 1.45em; }
.ed__row .ok { color: #17703f; } .ed__row .todo { color: #9aa2ad; font-style: italic; }
.ed__row.is-on { background: #f5f8fe; box-shadow: inset 3px 0 0 #1f5bd6; }
.ed__row.is-on .tgt { outline: 1.5px solid #1f5bd6; outline-offset: 3px; border-radius: 2px; }
.ed__term { text-decoration: underline; text-decoration-color: #1f5bd6; text-underline-offset: 3px; }
.ed__st { display: grid; place-items: center; height: 20px; }
.ed__st svg { width: 15px; height: 15px; }
.ed__st .done { color: #17703f; } .ed__st .edit { color: #b07a00; }
.ed__st { position: relative; } .ed__st > * { grid-area: 1 / 1; }
.ed__pane { padding: 12px 14px; display: grid; gap: 8px; align-content: start; font-size: 13px; }
.ed__pane h4 { margin: 0; font: 500 12px/1.3 var(--font-text); color: #4c5562; }
.ed__hit { border: 1px solid #d8e2f5; border-radius: 8px; padding: 8px 10px; display: grid; gap: 2px; }
.ed__hit.is-best { border-color: #1f5bd6; box-shadow: 0 0 0 1px #1f5bd6; }
.ed__hit small { color: #7b8491; font-size: 12px; }
.ed__score { justify-self: start; font: 500 11px/1 var(--font-mono); padding: 3px 6px; border-radius: 4px; background: #e3f1e8; color: #17703f; }
.ed__del { text-decoration: line-through; color: #aa2219; } .ed__ins { color: #17703f; background: #e3f1e8; border-radius: 2px; }
@media (max-width: 1023px) { .ed__body { grid-template-columns: 1fr; } .ed__pane { display: none; } .ed__segs { border-right: 0; } }
@media (max-width: 639px) {
  .hero--centred .hero__window { min-height: 200px; }
  .ed__bar .ed__prog, .ed__bar .ed__file { display: none; }
  .ed__row { grid-template-columns: minmax(0, 1fr) 22px; padding: 9px 12px; font-size: 13px; }
  .ed__row .n { display: none; } .ed__row .src { grid-column: 1; color: #4c5562; } .ed__row .tgt { grid-column: 1; } .ed__row .ed__st { grid-column: 2; grid-row: 1 / span 2; }
  .ed__row--far, .ed__row--near { display: none; }
}

/* Screens of the app inside the cards and the chapters: the top left of the screen, cut by the frame. */
#terminology .panel { --p-h: 300px; background: linear-gradient(160deg, #e4ecfb, #cfdcf6); }
#terminology .panel img { position: absolute; left: 28px; top: 28px; width: max(560px, 112%); max-width: none; height: auto;
  border-radius: 8px 0 0 0; box-shadow: 0 0 0 1px rgb(26 31 38 / .08), 0 18px 40px -22px rgb(20 50 120 / .4); transition: transform .5s cubic-bezier(.22,1,.36,1); }
#terminology .card:hover .panel img { transform: scale(1.02); transform-origin: 0 0; }
#terminology .panel img.is-paper { width: max(520px, 104%); }
@media (max-width: 639px) { #files .frame { --ratio: 62%; aspect-ratio: auto; } [data-moment="pinned-chapters"]:not(.is-live) .mo-pc__visual > img { max-height: 32svh; } #terminology .panel { --p-h: 126px; } #terminology .panel img { left: 18px; top: 18px; width: 460px; } }
[data-moment="pinned-chapters"] .mo-pc__visual > img { object-position: left top; background: #f3f5f8; }
main > #workflow[data-moment]:not(.is-live) { min-height: 200vh; min-height: 200lvh; }
main > #workflow[data-moment]:not(.is-live) > .mo-pc__grid { align-self: center; }
[data-moment="pinned-chapters"] .mo-pc__visual { box-shadow: 0 0 0 1px rgb(26 31 38 / .08), 0 24px 50px -30px rgb(20 50 120 / .4); background: #f3f5f8; }

/* The statement: one line set as large as the page allows. */
#delivery .mo-lt__type { font-size: clamp(44px, 6.4vw, 96px); line-height: 1; max-width: 11ch; }
#delivery .wrap { align-content: center; min-height: 100%; }
#delivery p { font-size: var(--t-lead); max-width: 44ch; color: var(--ink); }
/* beside it, the file it is about: a segment of an SDLXLIFF with only two lines changed */
.xd { align-self: center; background: #1a1f26; color: #c9d0da; border-radius: var(--r-lg); overflow: hidden; box-shadow: 0 30px 60px -30px rgb(20 50 120 / .45); }
.xd__bar { display: flex; align-items: center; gap: 10px; height: 40px; padding: 0 16px; color: #989ca1; font: 500 12px/1 var(--font-text); background: #222831; }
.xd__bar .ed__dots i { background: #3a414b; }
.xd__count { color: #8fd6a8; }
.xd__body { padding: 14px 0; font: 400 13px/1.9 var(--font-mono); }
.xd__ln { display: grid; grid-template-columns: 44px minmax(0, 1fr); padding-right: 16px; }
.xd__ln i { font-style: normal; color: #5d6672; text-align: right; padding-right: 14px; }
.xd__ln code { font: inherit; white-space: pre-wrap; overflow-wrap: anywhere; padding-left: 2ch; text-indent: -2ch; }
.xd__ln--add { background: rgb(23 112 63 / .32); color: #e6f6ec; box-shadow: inset 3px 0 0 #3fb672; }
.xd__ln--add i { color: #8fd6a8; }
@media (max-width: 1023px) { .xd { margin-top: var(--s-7); } }
@media (max-width: 639px) { .xd { margin-top: var(--s-6); } .xd__body { font-size: 11px; } .xd__ln { grid-template-columns: 32px minmax(0, 1fr); } .xd__ln--far, .xd__bar > span:nth-child(2) { display: none; } }

.btn--secondary { box-shadow: inset 0 0 0 1px rgb(26 31 38 / .45); }

/* The downloads: one card for each system, then the browser client and the team server. */
.dl { align-items: stretch; align-content: start; }
.dl__card { display: grid; gap: var(--s-3); align-content: start; }
.dl__card img { height: 40px; width: auto; }
.dl__card h3 { margin-top: var(--s-2); }
.dl__card .btn { justify-self: start; margin-top: var(--s-2); }
.dl__card .link { justify-self: start; }
.dl__card { transition: transform .18s cubic-bezier(.22,1,.36,1), box-shadow .18s; }
.dl__card:hover { transform: translateY(-2px); box-shadow: 0 14px 32px -18px rgb(20 50 120 / .35); }
@media (max-width: 639px) {
  main #download .dl__card { row-gap: 4px; padding: 0; background: none; border: 0; box-shadow: none; }
  .dl__card img { height: 24px; } .dl__card h3 { margin-top: 0; } .dl__card .btn { margin-top: var(--s-2); justify-self: stretch; justify-content: center; }
  main #download .card--open .panel { --p-h: 170px; }
  #download .section-head p { font-size: 16px; }
  .dl__card .link { display: none; }
  main #download .card--open > :is(.btn, .link) { justify-self: stretch; justify-content: center; }
  main #download .card--open > .link { justify-content: space-between; }
  .term__dim { display: none; } .term__body { font-size: 11px; line-height: 1.5; }
}
#download .card--open > .btn, #download .card--open > .link { justify-self: start; margin-top: var(--s-4); }
#download .card--open { display: grid; align-content: start; }
#download .card--open .panel { --p-h: 400px; background: linear-gradient(160deg, #e4ecfb, #cfdcf6); }
.shot-panel img { position: absolute; left: 28px; top: 28px; width: max(560px, 112%); max-width: none; height: auto; border-radius: 8px 0 0 0;
  box-shadow: 0 0 0 1px rgb(26 31 38 / .08), 0 18px 40px -22px rgb(20 50 120 / .4); transition: transform .5s cubic-bezier(.22,1,.36,1); }
.card:hover .shot-panel img { transform: scale(1.02); transform-origin: 0 0; }
.term { position: absolute; left: 28px; top: 28px; right: 28px; bottom: -40px; background: #1a1f26; color: #e6eaf0; border-radius: 10px; overflow: hidden;
  font: 400 13px/1.7 var(--font-mono); box-shadow: 0 18px 40px -22px rgb(20 50 120 / .5); }
.term__bar { display: flex; align-items: center; gap: 10px; height: 36px; padding: 0 14px; color: #989ca1; font: 500 12px/1 var(--font-text); border-bottom: 1px solid rgb(255 255 255 / .07); }
.term__bar .ed__dots i { background: #3a414b; }
.term__body { padding: 12px 16px; display: grid; gap: 4px; overflow-wrap: anywhere; }
.term__p { color: #8fb3f5; } .term__dim { color: #a4acb7; }
@media (max-width: 639px) { .shot-panel img { left: 18px; top: 18px; width: 460px; } .term { left: 18px; top: 18px; right: 18px; } }
@media (max-width: 639px) {
  #questions .stack-4 > p { display: none; }
  .footer__lede { display: none; }
  .closing__links .footer__col { grid-column: auto / span 4; }
}
@media (min-width: 640px) { [data-moment="pinned-chapters"]:not(.is-live) .mo-pc__visual > img { max-height: 40svh; } }
@media (min-width: 640px) and (max-height: 820px) {
  .ed__body { grid-template-columns: 1fr; } .ed__pane { display: none; } .ed__segs { border-right: 0; }
  .hero--centred .hero__window { min-height: 180px; }
  .hero--centred .hero__c { gap: var(--s-3); }
  .gl-gloss { margin: 0 0 0.04em; }
}
@media (max-width: 359px) { header.nav .nav__bar .nav__actions { display: none !important; } }

/* Beside the questions, the help pages as they answer one. */
.help-mock { display: grid; gap: 6px; margin-top: var(--s-6); padding: 14px; background: #fff; border-radius: var(--r-lg); color: var(--ink); text-decoration: none;
  box-shadow: 0 0 0 1px rgb(26 31 38 / .07), 0 24px 48px -30px rgb(20 50 120 / .35); transition: transform .18s cubic-bezier(.22,1,.36,1), box-shadow .18s; max-width: 440px; }
.help-mock:hover { transform: translateY(-2px); box-shadow: 0 0 0 1px rgb(26 31 38 / .1), 0 28px 52px -28px rgb(20 50 120 / .45); }
.help-mock__search { display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 12px; border-radius: 8px; box-shadow: inset 0 0 0 1px #c4cad3; font: 400 14px/1 var(--font-text); }
.help-mock__search svg { width: 15px; height: 15px; color: #7b8491; }
.help-mock__hit { display: grid; gap: 2px; padding: 10px 12px; border-radius: 8px; font-size: 14px; }
.help-mock__hit b { font-weight: 500; } .help-mock__hit small { color: #4c5562; font-size: 13px; line-height: 1.45; }
.help-mock__hit.is-on { background: #eef3fd; }
.help-mock mark { background: #dde7fb; color: inherit; border-radius: 2px; padding: 0 2px; }
@media (max-width: 1279px) { .help-mock, .faq__item--wide { display: none; } }

/* Motion, kept small. Each piece runs once or answers the pointer; nothing loops on its own but the
   editor's own steps, and nothing moves under reduced motion. */
@media (prefers-reduced-motion: no-preference) {
  /* the gloss is written in after its line, as notes are written under a text */
  .hero[data-enter]:is(.is-entering, .is-entered):not(.is-still) .gl-gloss { animation: gl-in .9s cubic-bezier(.22,1,.36,1) both; }
  .hero[data-enter]:is(.is-entering, .is-entered):not(.is-still) .gl-line:first-child .gl-gloss { animation-delay: .55s; }
  .hero[data-enter]:is(.is-entering, .is-entered):not(.is-still) .gl-line:last-child .gl-gloss { animation-delay: .75s; }
  @keyframes gl-in { from { opacity: 0; clip-path: inset(0 100% 0 0); } to { opacity: 1; clip-path: inset(0 0 0 0); } }
  /* hovering the headline turns the gloss through its languages */
  .gl-gloss { transition: opacity .22s ease, translate .22s ease; }
  .gl-gloss.is-swapping { opacity: 0; translate: 0 2px; }
  /* the light in the window's frame settles once on load */
  .hero--centred .hero__window::before { content: ""; position: absolute; inset: -10%; z-index: 0; pointer-events: none;
    background: radial-gradient(38% 55% at 50% 30%, rgb(255 255 255 / .55), transparent 70%);
    animation: il-light 2.4s cubic-bezier(.22,1,.36,1) .3s both; }
  @keyframes il-light { from { opacity: 0; transform: translateY(-12%) scale(.92); } to { opacity: 1; transform: none; } }
  /* in the editor, the translation is written out and the check mark drawn */
  .ed__row .tgt [data-step] { display: block; transition: clip-path .9s steps(24, end), opacity .1s; clip-path: inset(0 0 0 0); }
  .ed__row .tgt [data-step].is-off { opacity: 1; transform: none; clip-path: inset(0 100% 0 0); }
  .ed__st svg.done[data-step] path { stroke-dasharray: 16; stroke-dashoffset: 0; transition: stroke-dashoffset .45s cubic-bezier(.22,1,.36,1) .1s; }
  .ed__st svg.done[data-step].is-off { opacity: 1; transform: none; }
  .ed__st svg.done[data-step].is-off path { stroke-dashoffset: 16; transition: none; }
  /* the file beside the statement: pointing at it dims what did not change */
  .xd__ln { transition: opacity .35s ease, background-color .35s ease; }
  .xd:hover .xd__ln:not(.xd__ln--add) { opacity: .42; }
  .xd:hover .xd__ln--add { background: rgb(23 112 63 / .48); }
  /* the system icon rises a little with its card */
  .dl__card img { transition: transform .3s cubic-bezier(.22,1,.36,1); }
  .dl__card:hover img { transform: translateY(-2px); }
}
</style>
</head>
<body>
<!-- type: software (an open-source CAT tool; page type software, site-kind software)
     deal: hero centred, nav nav-centre, close close-type, footer footer-dark, rhythm surface-pairs,
     buttons pill, mark ring (replaced by the app's own icon), ground sky (lit frame, CSS only)
     palette: the client's own (start.mjs brand: #f3f5f8, #1a1f26, #1f5bd6 from DESIGN.md), type instrument
     moments: liquid-type in #delivery (the statement), pinned-chapters in #workflow (three steps) -->
<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href="#top"><svg class="il-mark" viewBox="0 0 512 512" aria-hidden="true"><rect x="32" y="32" width="448" height="448" rx="112" fill="#1f5bd6"/><rect x="128" y="160" width="256" height="32" rx="16" fill="#fff"/><rect x="128" y="240" width="176" height="32" rx="16" fill="#fff" fill-opacity=".55"/><rect x="128" y="320" width="256" height="32" rx="16" fill="#fff"/></svg>Interlinea</a>
    <nav class="nav__links" aria-label="Main">
      <div class="nav__item"><a class="nav__link" href="#files">Files</a></div>
      <div class="nav__item"><a class="nav__link" href="#terminology">Termbases</a></div>
      <div class="nav__item">
        <a class="nav__link" href="/docs/">Docs <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="nav__menu">
          <div class="wrap grid">
            <div class="menu-col span-3">
              <p class="t-label">Help</p>
              <a href="/docs/help/install/">Install<span>Windows, macOS and Linux</span></a>
              <a href="/docs/help/first-project/">First project<span>From a file to delivery</span></a>
              <a href="/docs/help/check-before-delivery/">Before delivery<span>Check Trados and memoQ files</span></a>
            </div>
            <div class="menu-col span-3">
              <p class="t-label">Manual</p>
              <a href="/docs/manual/guide/">Using Interlinea<span>Projects, editor, terminology</span></a>
              <a href="/docs/manual/formats/">File formats<span>What is read and written</span></a>
              <a href="/docs/manual/running/">Team server<span>Running one for a team</span></a>
            </div>
          </div>
        </div>
      </div>
      <div class="nav__item"><a class="nav__link" href={github}>GitHub</a></div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href="#download">Download Interlinea</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
