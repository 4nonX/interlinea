<?xml version="1.0" encoding="UTF-8"?>
<!--
  Interlinea built-in segmentation rules (SRX 2.0).
  Patterns use RE2 syntax: no look-around, no back-references.
  Order matters: the first rule matching a position decides.
-->
<srx xmlns="http://www.lisa.org/srx20" version="2.0">
  <header segmentsubflows="yes" cascade="yes"/>
  <body>
    <languagerules>
      <languagerule languagerulename="German">
        <!-- Common abbreviations (case-sensitive on purpose). -->
        <rule break="no">
          <beforebreak>(?:^|[\s(\[„"«»])(?:z\.\s?B|d\.\s?h|u\.\s?a|u\.\s?U|o\.\s?ä|s\.\s?o|s\.\s?u|i\.\s?d\.\s?R|i\.\s?S\.\s?d|u\.\s?v\.\s?m|usw|bzw|ca|vgl|ggf|evtl|inkl|exkl|zzgl|abzgl|bspw|etc|Nr|Abs|Art|Aufl|Bd|Hrsg|Kap|Anm|Tel|Fax|Str|St|Dr|Prof|Dipl|Ing|Hr|Fr|Mio|Mrd|Tsd|Jh|Jhd|Jg|Mo|Di|Mi|Do|Sa|So|Jan|Feb|Mär|Apr|Jun|Jul|Aug|Sep|Sept|Okt|Nov|Dez|lt|gem|bzgl|zit|Ziff|lit|Rn|Rdnr|Az|Verf|Beschl|Urt|Anl|einschl|sog|allg|insb|max|min|geb|verh|Ges|Gesch|AG|Kfz|Pkw|Lkw)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
        <!-- Section sign and paragraph references: "§ 5 Abs. 2". -->
        <rule break="no">
          <beforebreak>§\s?\d+[a-z]?\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
        <!-- Ordinal numbers followed by a lower-case word or a month: "am 1. Januar". -->
        <rule break="no">
          <beforebreak>\b\d{1,3}\.</beforebreak>
          <afterbreak>\s+(?:\p{Ll}|Januar|Jänner|Februar|März|April|Mai|Juni|Juli|August|September|Oktober|November|Dezember|Jahrhundert|Klasse|Stock|Obergeschoss|Untergeschoss|Auflage|Kapitel|Mal|Platz|Rang|Quartal|Halbjahr|Semester)</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="English">
        <rule break="no">
          <beforebreak>(?:^|[\s(\["“])(?:Mr|Mrs|Ms|Mx|Dr|Prof|Sr|Jr|St|Mt|Ft|Gen|Col|Lt|Sgt|Capt|Rev|Hon|Inc|Ltd|Co|Corp|Bros|Ave|Blvd|Rd|No|Nos|Vol|vols|pp|ch|chap|sec|art|para|fig|figs|cf|vs|etc|approx|dept|est|al|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec|Mon|Tue|Wed|Thu|Fri|Sat|Sun)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(?:^|[\s(\["“])(?:e\.g|i\.e|a\.m|p\.m|U\.S|U\.K|U\.N|E\.U|Ph\.D|B\.A|M\.A|B\.Sc|M\.Sc)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="CJK">
        <!-- Full-width sentence punctuation needs no following space. -->
        <rule break="yes">
          <beforebreak>[。！？]+[」』）】〉》”’]*</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Default">
        <!-- Single upper-case initials: "J. R. R. Tolkien". -->
        <rule break="no">
          <beforebreak>(?:^|\s)\p{Lu}\.</beforebreak>
          <afterbreak>\s+\p{Lu}</afterbreak>
        </rule>
        <!-- Decimal numbers and dotted numbering: "3.5", "1.2.3". -->
        <rule break="no">
          <beforebreak>\d\.</beforebreak>
          <afterbreak>\d</afterbreak>
        </rule>
        <!-- Ellipsis followed by lower case continues the sentence. -->
        <rule break="no">
          <beforebreak>(?:\.\.\.|…)</beforebreak>
          <afterbreak>\s+\p{Ll}</afterbreak>
        </rule>
        <!-- Sentence end: terminal punctuation, optional closing quotes or brackets, then space and a sentence start. -->
        <rule break="yes">
          <beforebreak>[.?!…]+["'“”‘’»«›‹)\]]*</beforebreak>
          <afterbreak>\s+[\p{Lu}\p{Lt}\p{N}"'“„‚«»(\[¿¡\p{Lo}]</afterbreak>
        </rule>
        <!-- Full-width punctuation also ends sentences in mixed text. -->
        <rule break="yes">
          <beforebreak>[。！？]+</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
        <!-- Explicit line breaks inside a paragraph. -->
        <rule break="yes">
          <beforebreak>\n</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
      </languagerule>
    </languagerules>

    <maprules>
      <languagemap languagepattern="de.*" languagerulename="German"/>
      <languagemap languagepattern="en.*" languagerulename="English"/>
      <languagemap languagepattern="(?:ja|zh|ko).*" languagerulename="CJK"/>
      <languagemap languagepattern=".*" languagerulename="Default"/>
    </maprules>
  </body>
</srx>
