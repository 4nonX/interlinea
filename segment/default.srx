<?xml version="1.0" encoding="UTF-8"?>
<!--
  Interlinea built-in segmentation rules (SRX 2.0).
  Patterns use RE2 syntax: no look-around, no back-references.
  Order matters: the first rule matching a position decides.
-->
<srx xmlns="http://www.lisa.org/srx20" version="2.0">
  <header segmentsubflows="yes" cascade="yes"/>
  <body>
    <languagerules>
      <languagerule languagerulename="German">
        <!-- Common abbreviations (case-sensitive on purpose). -->
        <rule break="no">
          <beforebreak>(?:^|[\s(\[„"«»])(?:z\.\s?B|d\.\s?h|u\.\s?a|u\.\s?U|o\.\s?ä|s\.\s?o|s\.\s?u|i\.\s?d\.\s?R|i\.\s?S\.\s?d|u\.\s?v\.\s?m|usw|bzw|ca|vgl|ggf|evtl|inkl|exkl|zzgl|abzgl|bspw|etc|Nr|Abs|Art|Aufl|Bd|Hrsg|Kap|Anm|Tel|Fax|Str|St|Dr|Prof|Dipl|Ing|Hr|Fr|Mio|Mrd|Tsd|Jh|Jhd|Jg|Mo|Di|Mi|Do|Sa|So|Jan|Feb|Mär|Apr|Jun|Jul|Aug|Sep|Sept|Okt|Nov|Dez|lt|gem|bzgl|zit|Ziff|lit|Rn|Rdnr|ff|f|Az|Verf|Beschl|Urt|Anl|einschl|sog|allg|insb|max|min|geb|verh|Ges|Gesch|AG|Kfz|Pkw|Lkw)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
        <!-- Section sign and paragraph references: "§ 5 Abs. 2". -->
        <rule break="no">
          <beforebreak>§\s?\d+[a-z]?\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
        <!-- Ordinal numbers followed by a lower-case word or a month: "am 1. Januar". -->
        <rule break="no">
          <beforebreak>\b\d{1,3}\.</beforebreak>
          <afterbreak>\s+(?:\p{Ll}|Januar|Jänner|Februar|März|April|Mai|Juni|Juli|August|September|Oktober|November|Dezember|Jahrhundert|Klasse|Stock|Obergeschoss|Untergeschoss|Auflage|Kapitel|Mal|Platz|Rang|Quartal|Halbjahr|Semester)</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="English">
        <rule break="no">
          <beforebreak>(?:^|[\s(\["“])(?:Mr|Mrs|Ms|Mx|Dr|Prof|Sr|Jr|St|Mt|Ft|Gen|Col|Lt|Sgt|Capt|Rev|Hon|Inc|Ltd|Co|Corp|Bros|Ave|Blvd|Rd|No|Nos|Vol|vols|pp|ch|chap|sec|art|para|fig|figs|cf|vs|etc|approx|dept|est|al|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec|Mon|Tue|Wed|Thu|Fri|Sat|Sun)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(?:^|[\s(\["“])(?:e\.g|i\.e|a\.m|p\.m|U\.S|U\.K|U\.N|E\.U|Ph\.D|B\.A|M\.A|B\.Sc|M\.Sc)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="French">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:M|MM|Mme|Mmes|Mlle|Mlles|Dr|Pr|Me|St|Ste|av|bd|art|al|chap|cf|ex|fig|pp|vol|no|nos|tél|env|éd|réf|N\.B|p\.\s?ex|c\.-à-d|J\.-C|S\.A|S\.A\.R\.L)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Spanish">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:Sr|Sra|Srta|Sres|Dr|Dra|Ud|Uds|Vd|Vds|Dña|Lic|Ing|Arq|Prof|art|núm|pág|págs|cap|vol|tel|teléf|aprox|fig|p\.\s?ej|a\.\s?C|d\.\s?C|EE\.\s?UU|S\.A|S\.L|av|avda|dpto|máx|mín)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Italian">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:Sig|Sig\.ra|Sigg|Dott|Dr|Prof|Avv|Ing|Arch|Geom|Rag|On|art|artt|nn|pag|pagg|cap|vol|fig|tel|cfr|ca|p\.\s?es|S\.p\.A|S\.r\.l|c\.d|u\.s)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Dutch">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:dhr|mevr|mw|dr|drs|prof|ir|ing|mr|bijv|bv|d\.w\.z|o\.a|m\.b\.t|i\.v\.m|t\.a\.v|t\.o\.v|evt|ca|nr|blz|art|incl|excl|tel|jl|z\.o\.z|n\.a\.v|m\.i\.v)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Portuguese">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:Sr|Sra|Srta|Dr|Dra|Prof|Profa|Eng|Exmo|Exma|V\.\s?Ex|art|nº|pág|págs|cap|vol|tel|fig|aprox|p\.\s?ex|Ltda|S\.A|av|obs)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Polish">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:np|tzn|tj|m\.in|ok|dr|prof|mgr|inż|ul|al|pl|nr|str|tel|art|ust|pkt|godz|tys|mln|mld|św|im|wg|ww)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Russian">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:т\.\s?е|т\.\s?д|т\.\s?п|т\.\s?к|т\.\s?н|др|пр|см|стр|рис|табл|гл|ст|пп|ул|тел|руб|коп|тыс|млн|млрд|им|проф|доц|акад|напр|вул|грн|обл)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Swedish">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:t\.ex|bl\.a|d\.v\.s|m\.m|ca|nr|kl|s\.k|f\.d|fr\.o\.m|t\.o\.m|dvs|resp|inkl|exkl|tel)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="DanishNorwegian">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:f\.eks|bl\.a|dvs|m\.m|ca|nr|kl|evt|inkl|ekskl|tlf|jf|pga|mht|iht|m\.v|o\.l|d\.v\.s)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="CzechSlovak">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:např|napr|tj|tzn|resp|č|str|obr|tab|odst|písm|čl|ul|tel|Ing|Mgr|JUDr|MUDr|PhDr|RNDr|doc|prof|sv|tzv|cca|s\.r\.o|a\.s|vč)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Hungarian">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:pl|ill|kb|ún|u\.n|dr|ifj|id|özv|sz|szt|db|tel|old|bek|ld|vö|max|min)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Romanian">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:dl|dna|dvs|dr|prof|ing|art|nr|pag|tel|str|bd|jud|ș\.a|d\.ex|S\.A|S\.R\.L|alin|lit|pct)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Turkish">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:Dr|Prof|Doç|Av|Sn|bkz|örn|No|Tel|Cad|Sok|Mah|Apt|Ltd|Şti|A\.Ş|T\.C)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Finnish">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:esim|ks|ns|ym|yms|tms|mm|nk|ko|ed|em|vrt|klo|puh|kpl|tri|prof|ins|dipl)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Greek">
        <rule break="no">
          <beforebreak>(?:^|[\s(\[«"“„])(?:κ|κα|κκ|δηλ|π\.χ|κ\.λπ|κ\.ά|βλ|σελ|αρ|τηλ|Δρ|Καθ|μ\.Χ|π\.Χ|Α\.Ε|Ε\.Π\.Ε|παρ|άρθ|εδ)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
        <!-- The Greek question mark is written as a semicolon. -->
        <rule break="yes">
          <beforebreak>[;\x{037e}]</beforebreak>
          <afterbreak>\s+[\p{Lu}«"(]</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="CJK">
        <!-- Full-width sentence punctuation needs no following space. -->
        <rule break="yes">
          <beforebreak>[。！？]+[」』）】〉》”’]*</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
      </languagerule>

      <languagerule languagerulename="Default">
        <!-- Single upper-case initials: "J. R. R. Tolkien". -->
        <rule break="no">
          <beforebreak>(?:^|\s)\p{Lu}\.</beforebreak>
          <afterbreak>\s+\p{Lu}</afterbreak>
        </rule>
        <!-- Decimal numbers and dotted numbering: "3.5", "1.2.3". -->
        <rule break="no">
          <beforebreak>\d\.</beforebreak>
          <afterbreak>\d</afterbreak>
        </rule>
        <!-- Ellipsis followed by lower case continues the sentence. -->
        <rule break="no">
          <beforebreak>(?:\.\.\.|…)</beforebreak>
          <afterbreak>\s+\p{Ll}</afterbreak>
        </rule>
        <!-- Sentence end: terminal punctuation, optional closing quotes or brackets, then space and a sentence start. -->
        <rule break="yes">
          <beforebreak>[.?!…؟۔।॥։።፧]+["'“”‘’»«›‹)\]]*</beforebreak>
          <afterbreak>\s+[\p{Lu}\p{Lt}\p{N}"'“„‚«»(\[¿¡\p{Lo}]</afterbreak>
        </rule>
        <!-- Full-width punctuation also ends sentences in mixed text, and so
             do the Burmese, Khmer and Tibetan full stops, which need no
             space after them. -->
        <rule break="yes">
          <beforebreak>[。！？။។៕།]+</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
        <!-- Explicit line breaks inside a paragraph. -->
        <rule break="yes">
          <beforebreak>\n</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
      </languagerule>
    </languagerules>

    <maprules>
      <languagemap languagepattern="de.*" languagerulename="German"/>
      <languagemap languagepattern="en.*" languagerulename="English"/>
      <languagemap languagepattern="fr.*" languagerulename="French"/>
      <languagemap languagepattern="es.*" languagerulename="Spanish"/>
      <languagemap languagepattern="it.*" languagerulename="Italian"/>
      <languagemap languagepattern="nl.*" languagerulename="Dutch"/>
      <languagemap languagepattern="pt.*" languagerulename="Portuguese"/>
      <languagemap languagepattern="pl.*" languagerulename="Polish"/>
      <languagemap languagepattern="(?:ru|uk|be|bg).*" languagerulename="Russian"/>
      <languagemap languagepattern="sv.*" languagerulename="Swedish"/>
      <languagemap languagepattern="(?:da|nb|nn|no).*" languagerulename="DanishNorwegian"/>
      <languagemap languagepattern="(?:cs|sk).*" languagerulename="CzechSlovak"/>
      <languagemap languagepattern="hu.*" languagerulename="Hungarian"/>
      <languagemap languagepattern="ro.*" languagerulename="Romanian"/>
      <languagemap languagepattern="tr.*" languagerulename="Turkish"/>
      <languagemap languagepattern="fi.*" languagerulename="Finnish"/>
      <languagemap languagepattern="el.*" languagerulename="Greek"/>
      <languagemap languagepattern="(?:ja|zh|ko).*" languagerulename="CJK"/>
      <languagemap languagepattern=".*" languagerulename="Default"/>
    </maprules>
  </body>
</srx>
